# Install as /etc/camel-gateway/gateway.env with owner root:root and mode 0600.
# Never commit the real qaml_live_ key.
CAMEL_API_KEY=qaml_live_REPLACE_ME
CAMEL_UPSTREAM_BASE_URL=https://stream.camelai.com

# Conservative defaults. Generation POST replay is disabled unless explicitly enabled.
GATEWAY_MAX_RETRIES=1
GATEWAY_RETRY_POST_GENERATION=false
GATEWAY_RETRY_MAX_DELAY_SECONDS=60
GATEWAY_CONNECT_TIMEOUT_SECONDS=10
GATEWAY_WRITE_TIMEOUT_SECONDS=60
GATEWAY_POOL_TIMEOUT_SECONDS=30
GATEWAY_QUEUE_POLL_SECONDS=0.20
GATEWAY_IO_CHUNK_SIZE=65536

# 0 means unlimited. Set an explicit byte limit when desired.
GATEWAY_MAX_REQUEST_BYTES=0
